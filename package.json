{
  "name": "lisa-hospitals",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "cd packages/db && npx tsc && cd ../../apps/api && npx tsc",
    "start": "node apps/api/dist/index.js",
    "lint": "turbo run lint",
    "db:push": "turbo run db:push --filter=@lisa/db",
    "db:migrate": "turbo run db:migrate --filter=@lisa/db",
    "db:studio": "turbo run db:studio --filter=@lisa/db"
  },
  "dependencies": {
    "turbo": "latest"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}